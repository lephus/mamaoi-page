# Copy sang .env.local roi dien gia tri that.

# --- SMTP: gui email (nodemailer, co pool) ---
# BREVO DA BI GO KHOI DU AN HOAN TOAN. Xoa moi bien BREVO_* khoi .env.local va
# khoi Vercel — khong con dong code nao doc chung.
#
# Contact/CRM cung khong con: Supabase la noi DUY NHAT giu ban ghi thanh vien.
# Vi vay ghi Supabase o /api/dang-ky nay la BAT BUOC (502 neu hong), khac truoc.
SMTP_HOST=zmhn112404.onemail.vn   # tuy chon, mac dinh chinh gia tri nay
SMTP_PORT=587
SMTP_USER=                        # vd: mamaoi@digitalunicorn.tech
SMTP_PASS=                        # mat khau SMTP
SMTP_FROM=                        # dia chi hien o dong "From", thuong trung SMTP_USER
SMTP_SENDER_NAME=Mama Oi          # tuy chon, mac dinh "Mama Oi"

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Sheets: ban ghi tho cho ops (bo trong = bo qua hoan toan) ---
# Service account phai duoc share Sheet voi quyen Editor, neu khong moi lan
# append tra ve 403.
GOOGLE_SHEET_ID=                # ID nam trong URL cua Sheet
GOOGLE_CLIENT_EMAIL=            # vd: xxx@yyy.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=             # private key PEM, giu nguyen \n

# --- Suc chua su kien ---
# So cho toi da. De trong = 500 (SUC_CHUA_MAC_DINH trong src/lib/constants.ts).
# Doi bien nay tren Vercel la ap dung ngay, khong can deploy lai.
# Chi nhan so nguyen duong; gia tri rac se roi ve 500.
# Dem tu cot Email cua tab "register" trong Google Sheet, nen thieu bien
# GOOGLE_* o tren la cong chan KHONG hoat dong (fail open, khong chan ai).
EVENT_CAPACITY=500

# Dong dang ky THU CONG: bat la coi nhu da du cho, du Sheet dem duoc bao nhieu.
# Form doi thanh khoi "Rat tiec, su kien da du 500 me", cac nut CTA tat, widget
# hien "Da du 500 me", va /api/dang-ky tu choi don moi (409).
# CHI nhan "1" hoac "true". De trong / "0" / "false" = dang ky mo binh thuong.
# Doi bien nay tren Vercel la ap dung ngay, khong can deploy lai.
DANG_KY_DA_DAY=

# --- Supabase (kho dang ky + trang thai check-in) ---
SUPABASE_URL=https://ynebuselhjttlvbfpklb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # service role key (chi dung server-side, KHONG bao gio de lo ra client)

# --- Admin (/admin) ---
ADMIN_EMAIL=                    # email dang nhap admin, vd: admin@digitalunicorn.fr
ADMIN_PASSWORD=                 # mat khau admin
ADMIN_SESSION_SECRET=           # chuoi ngau nhien ky cookie phien: openssl rand -base64 32

# --- Base URL cho QR / duong dan check-in (tuy chon, mac dinh https://mamaoi.vn) ---
NEXT_PUBLIC_SITE_URL=https://mamaoi.vn
